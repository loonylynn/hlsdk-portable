@PointClass base(Targetname) color(128 160 192) = env_fog : "Map-wide atmospheric fog controller. Only one env_fog controller is active at a time. Inputs accept USE_ON, USE_OFF and USE_TOGGLE activations."
[
	fogcolor(color255) : "Fog color (RGB)" : "128 128 128"
	startdist(float) : "Fog start distance" : "0"
	enddist(float) : "Fog end distance" : "3500"
	density(float) : "Exponential density curve" : "0.0003"
	maxdensity(float) : "Maximum fog opacity (0-1)" : "1.0"
	radial(choices) : "Radial distance" : 1 =
	[
		0 : "Axial (view depth)" : 0
		1 : "Radial (camera distance)" : 1
	]
	skybox(choices) : "Apply fog to skybox" : 0 =
	[
		0 : "No" : 0
		1 : "Yes" : 1
	]
	spawnflags(flags) =
	[
		1 : "Start active" : 0
	]
]
